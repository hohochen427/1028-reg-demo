# ──────────────────────────────────────────────────────────────
# RAG-demo 環境變數
# 複製本檔成 .env 再視需要填入金鑰。.env 已列入 .gitignore，絕對不要 commit。
# 什麼都不填也能跑：預設是離線模式，零設定、零金鑰。
# ──────────────────────────────────────────────────────────────

# 【儲存層】file = 離線示範（寫在 .data/，零設定）；pg = Neon Postgres（正式部署）
RAG_STORE=file

# Neon 連線字串（RAG_STORE=pg 時必填，從 Neon Console 複製 Pooled connection string）
DATABASE_URL=

# 【Embedding】voyage = Voyage AI（語意搜尋，正式部署用）；local = 離線字元 n-gram（語意能力有限，僅供試跑）
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
# 向量維度：voyage-3 為 1024；local 為 256。改這個值要重建資料表並重新建庫。
EMBEDDING_DIM=256

# 【LLM】claude = Claude API（正式部署用）；local = 離線抽取式回答（不呼叫模型，僅供試跑）
LLM_PROVIDER=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# 每次回答要帶幾段 Context
TOP_K=4

# 【登入保護】設定後，整站（除了 /login）都需要先輸入這組密碼。
# 留空 = 不要求登入，方便本機離線試跑；正式部署建議一定要設定。
ADMIN_PASSWORD=
# 第一個管理員的 email。第一次用「ADMIN_EMAIL ＋ ADMIN_PASSWORD」登入時，會自動在 users 表建立這個管理員帳號；
# 之後的使用者由管理員到 /admin 的「使用者管理」新增。設了 ADMIN_PASSWORD 卻沒設 ADMIN_EMAIL，沒有人能登入。
ADMIN_EMAIL=
# 用來簽登入 Token 的密鑰，建議另外設定一組隨機字串；留空會退回用 ADMIN_PASSWORD 本身。
AUTH_SECRET=
